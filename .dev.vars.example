# Nongtori local runtime secret/config template
# Copy only the values needed by the capability you are testing.
# Never commit the real .dev.vars file.
#
# DB and FILES are Cloudflare resource bindings, not string variables.

GOOGLE_TRANSLATE_API_KEY=

# Phone verification capability
SMS_VERIFICATION_URL=
SMS_VERIFICATION_TOKEN=
PHONE_VERIFICATION_PEPPER=

# Notification worker / SMS alert capability
NOTIFICATION_WORKER_TOKEN=
SMS_ALERT_URL=
SMS_ALERT_TOKEN=

# External worker / integration capability
FORECAST_WORKER_TOKEN=
ROBOT_INGEST_TOKEN=
VENDOR_IMPORT_TOKEN=
