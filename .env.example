# TORI common local environment template
# Canonical local files:
#   .env.example  -> committed names/template
#   .env.local    -> real local values, never commit
#
# Cloudflare resource bindings DB and FILES are not string variables.

# Nongtori runtime capabilities
GOOGLE_TRANSLATE_API_KEY=

# Phone verification
SMS_VERIFICATION_URL=
SMS_VERIFICATION_TOKEN=
PHONE_VERIFICATION_PEPPER=

# Notification / SMS alert
NOTIFICATION_WORKER_TOKEN=
SMS_ALERT_URL=
SMS_ALERT_TOKEN=

# External worker / integration
FORECAST_WORKER_TOKEN=
ROBOT_INGEST_TOKEN=
VENDOR_IMPORT_TOKEN=

# Local research: Dryad
# Long-lived API account credentials. The data pipeline exchanges these
# for a short-lived access token automatically.
DRYAD_CLIENT_ID=
DRYAD_CLIENT_SECRET=

# Optional one-off override only; normally leave blank.
DRYAD_TOKEN=

# Local research: Mendeley / Digital Commons Data
# One-time API client registration; thereafter public dataset downloads are automatic.
MENDELEY_DATA_CLIENT_ID=
MENDELEY_DATA_CLIENT_SECRET=

# Optional short-lived override only; normally leave blank.
MENDELEY_DATA_TOKEN=

# Local research: Roboflow Universe public dataset acquisition
# Keep the real key only in .env.local.
ROBOFLOW_API_KEY=
